---
import Cierre from '../../components/Cierre.astro';
import Icono from '../../components/Icono.astro';
import LandingDestacada from '../../components/LandingDestacada.astro';
import Tira from '../../components/Tira.astro';
import Base from '../../layouts/Base.astro';
import { pesosMXN } from '../../lib/formato';
import { landings, precioMinimo } from '../../lib/landings';
import { enlaceWhatsApp, mensajes } from '../../lib/whatsapp';

const total = landings.length;
const desde = pesosMXN(precioMinimo);
const cuenta = total === 1 ? '1 modelo publicado' : `${total} modelos publicados`;
// Con 1 o 2 modelos, cada uno va en grande; desde 3, en tiras del muestrario.
const enGrande = total <= 2;
---

<Base
  titulo="Landings a la venta"
  descripcion={`Landings listas para negocios en México. Míralas funcionando, pruébalas con otros colores y la publicamos con tus datos. Desde ${desde} MXN.`}
>
  <section class="seccion indice" aria-labelledby="indice-titulo">
    <div class="wrap">
      <header class="indice__cabeza">
        <h1 id="indice-titulo" class="display entra-1">Landings a la venta</h1>
        <p class="entrada entra-2">
          Landings listas para negocios en México. Las ves funcionando, eliges la combinación de color y
          la publicamos con tus datos. Desde {desde} MXN.
        </p>
        <p class="indice__cuenta entra-2">{cuenta} · un giro nuevo cada día</p>
      </header>

      <ul class:list={['indice__tiras', { 'indice__tiras--grandes': enGrande }]}>
        {
          landings.map((landing, i) => (
            <li>
              {enGrande ? (
                <LandingDestacada landing={landing} nivel={2} prioridad={i === 0} />
              ) : (
                <Tira landing={landing} nivel={2} prioridad={i < 2} />
              )}
            </li>
          ))
        }
        <li class="indice__pide">
          <h2 class="titulo">Pide la de tu giro</h2>
          <p>
            Sale una landing nueva cada día. Si la tuya todavía no está, dinos tu giro y la ponemos en la
            fila.
          </p>
          <a class="btn btn--secundario" href={enlaceWhatsApp(mensajes.landings)} rel="noopener">
            <Icono nombre="whatsapp" /> Pedir mi giro
          </a>
        </li>
      </ul>
    </div>
  </section>

  <Cierre />
</Base>

<style>
  .indice {
    padding-top: clamp(2.5rem, 1.5rem + 4vw, 4.5rem);
  }

  .indice__cabeza {
    display: grid;
    gap: var(--s-4);
    margin-bottom: clamp(2rem, 1.4rem + 2.4vw, 3.5rem);
  }

  .indice__cuenta {
    color: var(--ink-3);
    font-size: 0.9375rem;
    font-weight: 600;
  }

  /* De 1 a 30 tiras: lista en celular, columnas de 16 a 20 rem desde tablet. */
  .indice__tiras {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--s-4);
    padding: 0;
    list-style: none;
  }

  .indice__pide {
    display: grid;
    gap: var(--s-3);
    align-content: start;
    justify-items: start;
    padding: var(--s-6);
    border: 1px dashed var(--line-strong);
    border-radius: var(--radius-md);
  }

  .indice__pide p {
    color: var(--ink-2);
  }

  @media (min-width: 48rem) {
    .indice__tiras:not(.indice__tiras--grandes) {
      grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
    }

    .indice__tiras:not(.indice__tiras--grandes) .indice__pide {
      align-content: center;
    }

    .indice__tiras--grandes .indice__pide {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      column-gap: var(--s-8);
    }

    .indice__tiras--grandes .indice__pide h2,
    .indice__tiras--grandes .indice__pide p {
      grid-column: 1;
    }

    .indice__tiras--grandes .indice__pide .btn {
      grid-column: 2;
      grid-row: 1 / span 2;
    }
  }
</style>
