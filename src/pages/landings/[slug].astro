---
import type { GetStaticPaths } from 'astro';
import Cierre from '../../components/Cierre.astro';
import Icono from '../../components/Icono.astro';
import Preguntas from '../../components/Preguntas.astro';
import Tira from '../../components/Tira.astro';
import VisorDemo from '../../components/VisorDemo.astro';
import { preguntasLanding } from '../../data/preguntas';
import { sitio } from '../../data/sitio';
import Base from '../../layouts/Base.astro';
import { fechaLarga, pesosMXN } from '../../lib/formato';
import { type Landing, landings } from '../../lib/landings';
import { enlaceWhatsApp, mensajes } from '../../lib/whatsapp';

export const getStaticPaths = (() =>
  landings.map((landing) => ({ params: { slug: landing.slug }, props: { landing } }))) satisfies GetStaticPaths;

interface Props {
  landing: Landing;
}

const { landing } = Astro.props;
const giro = landing.giro.toLowerCase();
const laQuiero = enlaceWhatsApp(mensajes.laQuiero(landing));
const pregunta = enlaceWhatsApp(mensajes.pregunta(landing));
const otras = landings.filter((l) => l.slug !== landing.slug).slice(0, 3);
const precio = pesosMXN(landing.precio_desde);
const url = new URL(landing.href, sitio.url).href;

const medida = (valor: number | null, unidad: string) =>
  valor === null ? 'Se mide al publicar la demo' : `${valor} ${unidad}`;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: `Landing para ${giro} · ${landing.nombre}`,
  sku: landing.codigo,
  description: landing.resumen,
  url,
  brand: { '@type': 'Organization', name: sitio.nombre, url: sitio.url },
  offers: {
    '@type': 'Offer',
    price: landing.precio_desde,
    priceCurrency: 'MXN',
    availability: 'https://schema.org/InStock',
    url,
  },
};
---

<Base
  titulo={`Landing para ${giro} ${landing.codigo}`}
  descripcion={`${landing.resumen} Desde ${precio} MXN. Mírala funcionando y pruébala con otros colores.`}
  schema={schema}
  claseBody="con-barra"
>
  <div class="wrap ficha">
    <nav class="migas" aria-label="Ruta">
      <ol>
        <li><a href="/landings/">Landings a la venta</a></li>
        <li aria-current="page">{landing.giro}</li>
      </ol>
    </nav>

    <header class="ficha__cabeza">
      <h1 class="display ficha__titulo entra-1">Landing para {giro}</h1>
      <p class="ficha__meta entra-2">
        <span class="codigo">{landing.codigo}</span>
        <span>Modelo {landing.nombre}</span>
        <span>Publicada el <time datetime={landing.fecha}>{fechaLarga(landing.fecha)}</time></span>
      </p>
      <p class="entrada ficha__resumen entra-2">{landing.resumen}</p>
    </header>

    <section class="ficha__demo entra-4" aria-label="Demo en vivo">
      <VisorDemo landing={landing} />
    </section>

    <aside class="ficha__compra" aria-labelledby="compra-titulo">
      <div class="compra-caja">
        <h2 id="compra-titulo" class="visually-hidden">Precio y compra</h2>
        <p class="compra-caja__precio">
          <span>desde</span>
          <strong class="cifra">{precio}</strong>
          <span>MXN</span>
        </p>
        <p class="compra-caja__mantenimiento">
          Mantenimiento: <span class="cifra">{pesosMXN(landing.mantenimiento_mes)}</span> MXN al mes
        </p>
        <div class="compra-caja__acciones">
          <a class="btn btn--primario" href={laQuiero} rel="noopener">
            <Icono nombre="whatsapp" /> La quiero para mi negocio
          </a>
          <a class="btn btn--secundario" href={pregunta} rel="noopener">Tengo una pregunta</a>
        </div>
        <dl class="compra-caja__datos">
          <div>
            <dt>Plazo</dt>
            <dd>{landing.plazo} desde que tenemos tus datos</dd>
          </div>
          <div>
            <dt>Para</dt>
            <dd>{landing.para}</dd>
          </div>
        </dl>
        <h3 class="compra-caja__subtitulo">Qué incluye</h3>
        <ul class="lista-check">
          {
            landing.incluye.map((item) => (
              <li>
                <Icono nombre="check" />
                <span>{item}</span>
              </li>
            ))
          }
          <li><Icono nombre="check" /><span>El código fuente, a tu nombre, al pagar</span></li>
        </ul>
      </div>
    </aside>
  </div>

  <section class="seccion tecnica" aria-labelledby="tecnica-titulo">
    <div class="wrap">
      <div class="seccion__cabeza">
        <h2 id="tecnica-titulo" class="titulo-seccion">Ficha técnica</h2>
        <p>
          Todo lo que cambia de un negocio a otro vive en un archivo de configuración. Para adaptarla a
          tu negocio no se toca el diseño.
        </p>
      </div>
      <div class="tecnica__rejilla">
        <div>
          <h3 class="titulo">Qué se puede editar</h3>
          <ul class="tecnica__lista">
            {landing.editable.map((campo) => <li>{campo}</li>)}
          </ul>
        </div>
        <div>
          <h3 class="titulo">Datos técnicos</h3>
          <dl class="tecnica__datos">
            <div>
              <dt>Peso de la página</dt>
              <dd>{medida(landing.ficha_tecnica.peso_kb, 'KB')}</dd>
            </div>
            <div>
              <dt>Lighthouse en celular</dt>
              <dd>{medida(landing.ficha_tecnica.lighthouse_movil, 'de 100')}</dd>
            </div>
            <div>
              <dt>Tecnología</dt>
              <dd>HTML y CSS estáticos hechos con Astro, casi sin JavaScript</dd>
            </div>
            <div>
              <dt>Hosting</dt>
              <dd>Cualquier hosting estático: Netlify, Vercel, Cloudflare Pages o el tuyo</dd>
            </div>
          </dl>
        </div>
      </div>
    </div>
  </section>

  <section class="seccion ficha-preguntas" aria-labelledby="ficha-preguntas-titulo">
    <div class="wrap ficha-preguntas__rejilla">
      <h2 id="ficha-preguntas-titulo" class="titulo-seccion">Preguntas frecuentes</h2>
      <Preguntas preguntas={preguntasLanding(landing.plazo)} />
    </div>
  </section>

  {
    otras.length > 0 && (
      <section class="seccion otras" aria-labelledby="otras-titulo">
        <div class="wrap">
          <div class="seccion__cabeza">
            <h2 id="otras-titulo" class="titulo-seccion">
              Otras landings
            </h2>
          </div>
          <ul class="otras__tiras">
            {otras.map((l) => (
              <li>
                <Tira landing={l} />
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <Cierre
    titulo="Pídela para tu negocio"
    texto={`Mándanos un WhatsApp con el código ${landing.codigo}. Te decimos qué datos necesitamos y cuándo queda lista.`}
    mensaje={mensajes.laQuiero(landing)}
  />

  <div class="barra-compra" aria-label="Comprar esta landing" role="region">
    <p class="barra-compra__precio">
      <span class="codigo">{landing.codigo}</span>
      <span>desde <strong class="cifra">{precio}</strong> MXN</span>
    </p>
    <a class="btn btn--primario" href={laQuiero} rel="noopener"><Icono nombre="whatsapp" /> La quiero</a>
  </div>
</Base>

<style>
  .ficha {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--s-8);
    padding-block: var(--s-6) var(--section-y);
  }

  .migas ol {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    padding: 0;
    list-style: none;
    font-size: 0.9375rem;
    color: var(--ink-3);
  }

  .migas li + li::before {
    content: '/';
    margin-right: var(--s-2);
    color: var(--line-strong);
  }

  .migas a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  .migas [aria-current='page'] {
    display: inline-flex;
    align-items: center;
  }

  .ficha__cabeza {
    display: grid;
    gap: var(--s-4);
    margin-top: calc(var(--s-6) * -1);
  }

  .ficha__titulo {
    font-size: clamp(2.25rem, 1.4rem + 3.2vw, 4rem);
  }

  .ficha__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--s-4);
    color: var(--ink-3);
    font-size: 0.9375rem;
  }

  .ficha__meta .codigo {
    color: var(--ink);
    font-size: inherit;
  }

  .ficha__resumen {
    max-width: 52ch;
  }

  .ficha__demo {
    min-width: 0;
  }

  .compra-caja {
    display: grid;
    gap: var(--s-4);
    padding: var(--s-6);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--surface);
  }

  .compra-caja__precio {
    display: flex;
    align-items: baseline;
    gap: var(--s-2);
    color: var(--ink-2);
  }

  .compra-caja__precio strong {
    color: var(--ink);
    font-size: clamp(2.25rem, 1.8rem + 1.6vw, 3rem);
    font-weight: 750;
    line-height: 1;
  }

  .compra-caja__mantenimiento {
    margin-top: calc(var(--s-2) * -1);
    color: var(--ink-3);
    font-size: 0.9375rem;
  }

  .compra-caja__acciones {
    display: grid;
    gap: var(--s-3);
  }

  .compra-caja__acciones .btn {
    white-space: normal;
    text-align: center;
  }

  .compra-caja__datos {
    display: grid;
    gap: var(--s-3);
    padding-block: var(--s-4);
    border-block: 1px solid var(--line);
  }

  .compra-caja__datos dt {
    color: var(--ink-3);
    font-size: var(--fs-label);
    font-weight: 600;
  }

  .compra-caja__datos dd {
    margin: 0;
    color: var(--ink);
    font-size: 0.9375rem;
  }

  .compra-caja__subtitulo {
    font-size: 1.0625rem;
    font-weight: 700;
  }

  .lista-check {
    display: grid;
    gap: var(--s-2);
    padding: 0;
    list-style: none;
    font-size: 0.9375rem;
    line-height: 1.5;
  }

  .lista-check li {
    display: flex;
    gap: var(--s-2);
    align-items: flex-start;
  }

  .lista-check :global(.icono) {
    margin-top: 0.15em;
    color: var(--accent-ink);
  }

  @media (min-width: 64rem) {
    .ficha {
      grid-template-columns: minmax(0, 1fr) 22rem;
      column-gap: var(--s-8);
      row-gap: var(--s-6);
      align-items: start;
    }

    .migas,
    .ficha__cabeza {
      grid-column: 1 / -1;
    }

    .ficha__demo {
      grid-column: 1;
    }

    .ficha__compra {
      grid-column: 2;
      grid-row: 3 / span 2;
      position: sticky;
      top: var(--s-6);
    }
  }

  /* Ficha técnica */
  .tecnica {
    border-block: 1px solid var(--line);
    background: var(--surface);
  }

  .tecnica__rejilla {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--s-10);
  }

  .tecnica__rejilla h3 {
    margin-bottom: var(--s-4);
  }

  .tecnica__lista {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(12rem, 1fr));
    gap: var(--s-2) var(--s-6);
    padding: 0;
    list-style: none;
    color: var(--ink-2);
  }

  .tecnica__lista li {
    padding-block: var(--s-2);
    border-bottom: 1px solid var(--line);
  }

  .tecnica__datos {
    display: grid;
    gap: 0;
  }

  .tecnica__datos div {
    display: grid;
    gap: var(--s-1);
    padding-block: var(--s-3);
    border-bottom: 1px solid var(--line);
  }

  .tecnica__datos dt {
    color: var(--ink-3);
    font-size: var(--fs-label);
    font-weight: 600;
  }

  .tecnica__datos dd {
    margin: 0;
  }

  @media (min-width: 64rem) {
    .tecnica__rejilla {
      grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
      gap: clamp(3rem, 1rem + 5vw, 6rem);
    }
  }

  /* Preguntas */
  .ficha-preguntas__rejilla {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--s-8);
  }

  @media (min-width: 64rem) {
    .ficha-preguntas__rejilla {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr);
      gap: clamp(3rem, 1rem + 5vw, 6rem);
      align-items: start;
    }
  }

  .otras {
    padding-top: 0;
  }

  .otras__tiras {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr));
    gap: var(--s-4);
    padding: 0;
    list-style: none;
  }

  /* Barra fija de compra (celular y tablet) */
  .barra-compra {
    position: fixed;
    inset: auto 0 0;
    z-index: var(--z-bar);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
    padding: var(--s-3) var(--gutter) calc(var(--s-3) + env(safe-area-inset-bottom));
    border-top: 1px solid var(--line);
    background: var(--surface);
    box-shadow: var(--e2);
  }

  .barra-compra__precio {
    display: grid;
    line-height: 1.3;
    color: var(--ink-2);
    font-size: 0.875rem;
  }

  .barra-compra__precio .codigo {
    color: var(--ink);
    font-size: 0.875rem;
  }

  .barra-compra__precio strong {
    color: var(--ink);
    font-size: 1.125rem;
  }

  :global(body.con-barra) {
    padding-bottom: calc(4.75rem + env(safe-area-inset-bottom));
  }

  @media (min-width: 64rem) {
    .barra-compra {
      display: none;
    }

    :global(body.con-barra) {
      padding-bottom: 0;
    }
  }
</style>
