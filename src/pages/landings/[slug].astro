---
import type { GetStaticPaths } from 'astro';
import { type Landing, landingsEn } from '../../lib/landings';
import Ficha from '../../vistas/Ficha.astro';

export const getStaticPaths = (() =>
  landingsEn('es').map((landing) => ({ params: { slug: landing.slug }, props: { landing } }))) satisfies GetStaticPaths;

interface Props {
  landing: Landing;
}

const { landing } = Astro.props;
---

<Ficha landing={landing} />
