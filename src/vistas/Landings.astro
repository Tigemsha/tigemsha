---
/**
 * /landings y /en/landings: todas las landings con buscador, familias, orden
 * "más nuevas", contador y el mismo estado vacío que la home. El HTML trae las
 * primeras 24; el resto llega del índice compacto al buscar o con "Mostrar más".
 */
import Cierre from '../components/Cierre.astro';
import Vitrina from '../components/vitrina/Vitrina.astro';
import { alternasDe, type Idioma, t } from '../i18n';
import { pesosMXN } from '../lib/formato';
import { landingsEn, precioMinimo } from '../lib/landings';
import Base from '../layouts/Base.astro';

interface Props {
  idioma: Idioma;
}

const { idioma } = Astro.props;
const d = t(idioma);
const p = d.landingsPagina;
const landings = landingsEn(idioma);
const desde = pesosMXN(precioMinimo);
---

<Base idioma={idioma} titulo={p.titulo} descripcion={p.descripcion(desde)} alternas={alternasDe('landings')}>
  <section class="seccion indice" aria-labelledby="indice-titulo">
    <div class="wrap">
      <header class="indice__cabeza">
        <h1 id="indice-titulo" class="display entra-1">{p.titulo}</h1>
        <p class="entrada entra-2">{p.sub(desde)}</p>
        <p class="indice__cada-dia entra-2">{p.unaNuevaCadaDia}</p>
      </header>
      <div class="entra-3">
        <Vitrina idioma={idioma} modo="rejilla" landings={landings} limite={24} id="buscar-landings" nivel={2} />
      </div>
    </div>
  </section>

  <Cierre idioma={idioma} />
</Base>

<style>
  .indice {
    padding-top: clamp(2.5rem, 1.5rem + 4vw, 4.5rem);
  }

  .indice__cabeza {
    display: grid;
    gap: var(--s-4);
    margin-bottom: clamp(2rem, 1.4rem + 2.4vw, 3rem);
  }

  .indice__cada-dia {
    color: var(--ink-3);
    font-size: 0.9375rem;
    font-weight: 600;
  }
</style>
