---
/**
 * Captura de una landing con marca de agua: un patrón al ~8 % solo sobre la
 * imagen y el sello con el código. Nada de esto recibe clics.
 *
 * Sin `landing` dibuja el molde vacío que usa la vitrina en el navegador para
 * las tarjetas que no vienen en el HTML (src/scripts/vitrina.ts lo llena).
 */
import { Picture } from 'astro:assets';
import { type Idioma, t } from '../i18n';
import type { Landing } from '../lib/landings';
import Sello from './Sello.astro';

interface Props {
  landing?: Landing;
  /** Idioma del molde vacío (con landing se usa el suyo). */
  idioma?: Idioma;
  vista: keyof Landing['imagenes'];
  anchos: number[];
  sizes: string;
  /** Solo para la imagen del LCP. */
  prioridad?: boolean;
  /** Sin sello cuando quien la muestra pone el suyo (el visor lo pone sobre la demo). */
  sello?: boolean;
  clase?: string;
}

const { landing, vista, anchos, sizes, prioridad = false, sello = true, clase = '' } = Astro.props;
const idioma = landing?.idioma ?? Astro.props.idioma ?? 'es';
const d = t(idioma);
const alt = landing ? d.captura.alt(vista, landing.codigo, landing.giro.toLowerCase()) : '';
---

<figure class:list={['captura', clase]}>
  {
    landing ? (
      <Picture
        src={landing.imagenes[vista]}
        alt={alt}
        formats={['avif']}
        fallbackFormat="webp"
        widths={anchos}
        sizes={sizes}
        loading={prioridad ? 'eager' : 'lazy'}
        fetchpriority={prioridad ? 'high' : 'auto'}
        decoding="async"
        draggable="false"
      />
    ) : (
      <picture data-captura-molde>
        <source type="image/avif" sizes={sizes} />
        <img alt="" sizes={sizes} loading="lazy" decoding="async" draggable="false" />
      </picture>
    )
  }
  <span class="captura__marca" aria-hidden="true"></span>
  {sello && <Sello idioma={idioma} codigo={landing?.codigo ?? ''} />}
</figure>

<style>
  .captura {
    position: relative;
    overflow: hidden;
    background: var(--line);
    isolation: isolate;
  }

  .captura :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    -webkit-user-drag: none;
  }

  .captura__marca {
    position: absolute;
    inset: 0;
    background-image: url('../assets/brand/marca-de-agua.svg');
    background-size: 280px 180px;
    pointer-events: none;
  }
</style>
