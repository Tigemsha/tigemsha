---
/**
 * Captura de una landing con marca de agua: un patrón al ~8 % solo sobre la
 * imagen y el sello con el código. Nada de esto recibe clics.
 */
import { Picture } from 'astro:assets';
import type { Landing } from '../lib/landings';
import Sello from './Sello.astro';

interface Props {
  landing: Landing;
  vista: keyof Landing['imagenes'];
  anchos: number[];
  sizes: string;
  /** Solo para la imagen del LCP. */
  prioridad?: boolean;
  /** Sin sello cuando quien la muestra pone el suyo (el visor lo pone sobre la demo). */
  sello?: boolean;
  clase?: string;
}

const NOMBRE_VISTA = { movil: 'celular', escritorio: 'escritorio' } as const;

const { landing, vista, anchos, sizes, prioridad = false, sello = true, clase = '' } = Astro.props;
const alt = `Captura en ${NOMBRE_VISTA[vista]} de la landing ${landing.codigo} para ${landing.giro.toLowerCase()}`;
---

<figure class:list={['captura', clase]}>
  <Picture
    src={landing.imagenes[vista]}
    alt={alt}
    formats={['avif']}
    fallbackFormat="webp"
    widths={anchos}
    sizes={sizes}
    loading={prioridad ? 'eager' : 'lazy'}
    fetchpriority={prioridad ? 'high' : 'auto'}
    decoding="async"
    draggable="false"
  />
  <span class="captura__marca" aria-hidden="true"></span>
  {sello && <Sello codigo={landing.codigo} />}
</figure>

<style>
  .captura {
    position: relative;
    overflow: hidden;
    background: var(--line);
    isolation: isolate;
  }

  .captura :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    -webkit-user-drag: none;
  }

  .captura__marca {
    position: absolute;
    inset: 0;
    background-image: url('../assets/brand/marca-de-agua.svg');
    background-size: 280px 180px;
    pointer-events: none;
  }
</style>
