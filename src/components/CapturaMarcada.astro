---
/**
 * Captura de una landing con marca de agua: un patrón al ~8 % solo sobre la
 * imagen y un sello fijo con el código. Nada de esto recibe clics.
 */
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Props {
  imagen: ImageMetadata;
  alt: string;
  codigo: string;
  anchos: number[];
  sizes: string;
  /** Solo para la imagen del LCP. */
  prioridad?: boolean;
  clase?: string;
}

const { imagen, alt, codigo, anchos, sizes, prioridad = false, clase = '' } = Astro.props;
---

<figure class:list={['captura', clase]}>
  <Picture
    src={imagen}
    alt={alt}
    formats={['avif']}
    fallbackFormat="webp"
    widths={anchos}
    sizes={sizes}
    loading={prioridad ? 'eager' : 'lazy'}
    fetchpriority={prioridad ? 'high' : 'auto'}
    decoding={prioridad ? 'sync' : 'async'}
    draggable="false"
  />
  <span class="captura__marca" aria-hidden="true"></span>
  <span class="captura__sello codigo" aria-hidden="true">Muestra · {codigo}</span>
</figure>

<style>
  .captura {
    position: relative;
    overflow: hidden;
    background: var(--line);
    isolation: isolate;
  }

  .captura :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    -webkit-user-drag: none;
  }

  .captura__marca {
    position: absolute;
    inset: 0;
    background-image: url('../assets/brand/marca-de-agua.svg');
    background-size: 280px 180px;
    pointer-events: none;
  }

  .captura__sello {
    position: absolute;
    left: var(--s-2);
    bottom: var(--s-2);
    padding: 2px var(--s-2);
    border-radius: var(--radius-xs);
    background: var(--sello-bg);
    color: var(--sello-ink);
    font-size: 0.75rem;
    line-height: 1.5;
    letter-spacing: 0.04em;
    pointer-events: none;
    white-space: nowrap;
  }
</style>
