---
/**
 * Demostración 2 · Apps web: un navegador con tres sistemas de ejemplo para
 * la tlapalería de Luis, hechos en HTML/CSS (no son capturas).
 *
 * Con JS: pestañas accesibles (flechas, Inicio, Fin) que avanzan solas cada
 * 6.5 s mientras se ven; la barra de cada pestaña marca el tiempo y, al
 * terminar, servicios.ts pasa a la siguiente. Al elegir una pestaña se acaba
 * el recorrido automático. Al mostrarse, cada panel cuenta sus números, dibuja
 * su gráfica y mete sus filas.
 * Sin JS: los tres sistemas uno debajo del otro, en su estado final.
 */
import Controles from './Controles.astro';
import Glifo from './Glifo.astro';
import type { NombreGlifo } from './Glifo.astro';
import Rueda from './Rueda.astro';
import type { Textos } from './i18n';

interface Props {
  t: Textos;
}

const { t } = Astro.props;
const w = t.web;
const { inv, portal, pos } = w;

const iconosNegocio: NombreGlifo[] = ['package', 'receipt', 'cash-register', 'chart-bar'];
const iconosCliente: NombreGlifo[] = ['package', 'receipt', 'user-circle'];
const iconosProductos: NombreGlifo[] = ['package', 'paint-bucket', 'paint-brush', 'pipe', 'nut', 'hammer'];
const existencias = ['3', '142', '18', '64', '9'];
const estadosInv = ['quedan', 'ok', 'ok', 'ok', 'surtir'] as const;

// Compras del año (miles de pesos), suman $186,400.
const compras = [12, 15, 11, 18, 16, 21, 14, 19, 23, 17, 20.4];
const puntos = compras.map((v, i) => `${(i * 22).toFixed(1)},${(76 - v * 2.9).toFixed(1)}`);
const trazo = `M${puntos.join(' L')}`;
const area = `${trazo} L220,80 L0,80 Z`;

const shell = (cliente: boolean, activo: number) => ({
  items: cliente ? w.navCliente : w.navNegocio,
  iconos: cliente ? iconosCliente : iconosNegocio,
  activo,
});
const shells = [shell(false, 0), shell(true, 0), shell(false, 2)];
---

<figure class="web" data-grupo data-anima data-tabs>
  <figcaption class="visually-hidden">{w.descripcion}</figcaption>

  <div class="web__marco">
    <div class="web__tira">
      <span class="web__puntos" aria-hidden="true"><i></i><i></i><i></i></span>
      <div class="web__pestanas" role="tablist" aria-label={w.pestanasNombre} hidden>
        {
          w.pestanas.map((p, i) => (
            <button
              type="button"
              role="tab"
              id={`sv-tab-${i}`}
              class="pestana"
              aria-controls={`sv-panel-${i}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              tabindex={i === 0 ? 0 : -1}
              data-url={p.url}
            >
              <span class={`pestana__fav fav${i}`} aria-hidden="true">
                <Glifo n={(['package', 'truck', 'cash-register'] as const)[i] ?? 'package'} />
              </span>
              <span class="pestana__texto pestana__texto--largo">{p.nombre}</span>
              <span class="pestana__texto pestana__texto--corto">{p.corto}</span>
              <span class="pestana__pista" aria-hidden="true">
                <span class="pestana__barra" data-avance />
              </span>
            </button>
          ))
        }
      </div>
    </div>

    <div class="web__barra">
      <span class="web__url" aria-hidden="true">
        <Glifo n="lock-simple" />
        <span data-url-vista>{w.pestanas[0].url}</span>
      </span>
      <span class="web__sello">{t.datosEjemplo}</span>
    </div>

    <div class="web__paneles">
      {
        w.pestanas.map((p, i) => (
          <div class:list={['panel', `panel--${i}`, { activo: i === 0 }]} id={`sv-panel-${i}`} aria-labelledby={`sv-tab-${i}`} data-panel data-escena>
            <p class="panel__nombre">{p.nombre}</p>
            <p class="visually-hidden">{p.descripcion}</p>
            <div class="app" aria-hidden="true">
              <div class="app__lado">
                <span class="app__marca">
                  <span class="app__logo">TL</span>
                  <span class="app__marca-n">{w.marca}</span>
                </span>
                <span class="app__nav">
                  {shells[i]?.items.map((item, j) => (
                    <span class:list={['app__item', { activo: j === shells[i]?.activo }]}>
                      <Glifo n={shells[i]?.iconos[j] ?? 'package'} />
                      {item}
                    </span>
                  ))}
                </span>
              </div>

              <div class="app__main">
                {i === 0 && (
                  <>
                    <div class="app__cabeza">
                      <span class="app__titulos">
                        <span class="app__h">{inv.titulo}</span>
                        <span class="app__sub">
                          {inv.sucursal} <Glifo n="caret-down" />
                        </span>
                      </span>
                      <span class="app__buscar">
                        <Glifo n="magnifying-glass" />
                        {inv.buscar}
                      </span>
                    </div>
                    <div class="kpis">
                      <span class="kpi">
                        <span class="kpi__l">{inv.kpis[0]}</span>
                        <span class="kpi__v"><Rueda valor="1,284" /></span>
                      </span>
                      <span class="kpi">
                        <span class="kpi__l">{inv.kpis[1]}</span>
                        <span class="kpi__v"><Rueda valor="$412,580" /></span>
                      </span>
                      <span class="kpi kpi--alerta">
                        <span class="kpi__l">{inv.kpis[2]}</span>
                        <span class="kpi__v">
                          <Glifo n="warning" />
                          <Rueda valor="6" />
                        </span>
                      </span>
                    </div>
                    <div class="alerta">
                      <Glifo n="warning" />
                      <span class="alerta__t">
                        <b>{inv.alerta}</b> {inv.alertaDato}
                      </span>
                      <span class="alerta__btn">{inv.alertaAccion}</span>
                    </div>
                    <div class="inv__cuerpo">
                      <div class="tabla">
                        <span class="tabla__fila tabla__fila--cab">
                          <span>{inv.columnas[0]}</span>
                          <span class="num">{inv.columnas[1]}</span>
                          <span>{inv.columnas[2]}</span>
                        </span>
                        {inv.productos.map((producto, j) => (
                          <span class={`tabla__fila r${j}`}>
                            <span class="tabla__p">{producto}</span>
                            <span class="num">{existencias[j]}</span>
                            <span class={`chip chip--${estadosInv[j]}`}>
                              <Glifo n={estadosInv[j] === 'ok' ? 'check' : 'warning'} />
                              {inv.estados[estadosInv[j] ?? 'ok']}
                            </span>
                          </span>
                        ))}
                      </div>
                      <div class="grafica">
                        <span class="grafica__t">{inv.grafica}</span>
                        <span class="barras">
                          {inv.dias.map((_, j) => (
                            <span class={`barra h${j}`} />
                          ))}
                        </span>
                        <span class="ejes">
                          {inv.dias.map((d) => (
                            <span>{d}</span>
                          ))}
                        </span>
                      </div>
                    </div>
                  </>
                )}

                {i === 1 && (
                  <>
                    <div class="app__cabeza">
                      <span class="app__titulos">
                        <span class="app__h">{portal.saludo}</span>
                        <span class="app__sub">{portal.sub}</span>
                      </span>
                      <span class="app__avatar">CR</span>
                    </div>
                    <div class="pedido">
                      <span class="pedido__top">
                        <span class="app__titulos">
                          <span class="pedido__id">{portal.pedido}</span>
                          <span class="app__sub">{portal.detalle}</span>
                        </span>
                        <span class="pedido__eta">
                          <Glifo n="truck" />
                          {portal.llega}
                        </span>
                      </span>
                      <span class="ruta">
                        <span class="ruta__pista">
                          <span class="ruta__relleno" />
                          <i class="ruta__punto pk0" />
                          <i class="ruta__punto pk1" />
                          <i class="ruta__punto pk2" />
                          <i class="ruta__punto pk3" />
                          <span class="ruta__mover">
                            <span class="ruta__camion">
                              <Glifo n="truck" />
                            </span>
                          </span>
                        </span>
                        <span class="ruta__pasos">
                          {portal.pasos.map((paso, j) => (
                            <span class:list={['ruta__paso', { hecho: j < 2, actual: j === 2 }]}>{paso}</span>
                          ))}
                        </span>
                      </span>
                    </div>
                    <div class="portal__cuerpo">
                      <div class="lista">
                        {portal.lista.map(([id, detalle], j) => (
                          <span class={`lista__fila r${j}`}>
                            <span class="lista__id">{id}</span>
                            <span class="lista__d">{detalle}</span>
                            <span class:list={['chip', j < 2 ? 'chip--ok' : 'chip--neutro']}>
                              <Glifo n={j < 2 ? 'check' : 'receipt'} />
                              {portal.estados[j]}
                            </span>
                          </span>
                        ))}
                      </div>
                      <div class="grafica linea">
                        <span class="linea__cabeza">
                          <span class="grafica__t">{portal.grafica}</span>
                          <span class="linea__total">
                            <Rueda valor="$186,400" />
                          </span>
                        </span>
                        <span class="linea__ventana">
                          <span class="linea__mover">
                            <span class="linea__contra">
                              <svg viewBox="0 0 220 80" preserveAspectRatio="none" focusable="false">
                                <path class="linea__area" d={area} />
                                <path class="linea__trazo" d={trazo} />
                              </svg>
                            </span>
                          </span>
                        </span>
                        <span class="ejes ejes--meses">
                          {portal.meses.map((m) => (
                            <span>{m}</span>
                          ))}
                        </span>
                      </div>
                    </div>
                  </>
                )}

                {i === 2 && (
                  <>
                    <div class="app__cabeza">
                      <span class="app__titulos">
                        <span class="app__h">{pos.titulo}</span>
                        <span class="app__sub">{pos.sub}</span>
                      </span>
                      <span class="app__buscar">
                        <Glifo n="magnifying-glass" />
                        {pos.buscar}
                      </span>
                    </div>
                    <div class="pos">
                      <div class="pos__productos">
                        {pos.productos.map(([nombre, precio], j) => (
                          <span class={`producto k${j}`}>
                            <span class="producto__ic">
                              <Glifo n={iconosProductos[j] ?? 'package'} />
                            </span>
                            <span class="producto__n">{nombre}</span>
                            <span class="producto__p">{precio}</span>
                          </span>
                        ))}
                      </div>
                      <div class="ticket">
                        <span class="ticket__h">
                          <Glifo n="receipt" />
                          {pos.ticket}
                        </span>
                        <span class="ticket__lineas">
                          {pos.lineas.map(([detalle, valor], j) => (
                            <span class={`ticket__linea r${j}`}>
                              <span>{detalle}</span>
                              <span class="num">{valor}</span>
                            </span>
                          ))}
                        </span>
                        <span class="ticket__total">
                          <span>{pos.total}</span>
                          <Rueda valor="$1,875" desde="$1,680" />
                        </span>
                        <span class="ticket__cobrar">{pos.cobrar} $1,875</span>
                      </div>
                    </div>
                    <span class="aviso">
                      <Glifo n="check-circle" />
                      {pos.aviso}
                    </span>
                  </>
                )}
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>

  <Controles textos={t.controles} que={w.demoNombre} clase="web__controles" />
</figure>

<style>
  .web {
    position: relative;
    display: grid;
    gap: var(--s-3);
    margin: 0;
  }

  .web__marco {
    /* Paleta propia de la app de ejemplo (la tlapalería), no la del sitio. */
    --app-bg: #f5f7f8;
    --app-panel: #ffffff;
    --app-ink: #17212a;
    --app-ink-2: #56636d;
    --app-line: #e3e8eb;
    --app-lado: #16222c;
    --app-lado-ink: #b9c5cd;
    --app-acento: #e8590c;
    --app-acento-hondo: #b8430a;
    --app-acento-suave: #fff0e5;
    --app-alerta-bg: #fff4d6;
    --app-alerta-ink: #6f4500;
    --app-ok-bg: #e4f4eb;
    --app-ok-ink: #1d6741;
    --app-azul: #1f63c6;
    container: navegador / inline-size;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--surface);
    box-shadow: var(--e-device);
  }

  /* Tira de pestañas, como en un navegador de escritorio. */
  .web__tira {
    display: flex;
    align-items: flex-end;
    gap: var(--s-3);
    min-height: 2.25rem;
    padding: var(--s-2) var(--s-3) 0;
    background: var(--bg);
  }

  .web__puntos {
    display: flex;
    gap: 6px;
    align-self: center;
    padding-bottom: var(--s-1);
  }

  .web__puntos i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--line-strong);
  }

  .web__pestanas {
    flex: 1;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2px;
    max-width: 34rem;
  }

  .web__pestanas[hidden] {
    display: none;
  }

  .pestana {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.4375rem;
    min-width: 0;
    min-height: 2.75rem;
    padding: 0.25rem 0.625rem;
    border: 0;
    border-radius: 10px 10px 0 0;
    background: transparent;
    color: var(--ink-2);
    font-size: 0.8125rem;
    font-weight: 600;
    line-height: 1.2;
    text-align: left;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  .pestana[aria-selected='true'] {
    background: var(--surface);
    color: var(--ink);
  }

  @media (hover: hover) and (pointer: fine) {
    .pestana:hover:not([aria-selected='true']) {
      background: rgb(14 20 24 / 0.05);
    }
  }

  .pestana:focus-visible {
    outline-offset: -3px;
  }

  .pestana__fav {
    display: grid;
    place-items: center;
    flex: none;
    width: 1.125rem;
    height: 1.125rem;
    border-radius: 4px;
    color: #fff;
    font-size: 0.75rem;
  }

  .fav0 {
    background: var(--app-acento-hondo);
  }

  .fav1 {
    background: var(--app-azul);
  }

  .fav2 {
    background: var(--app-lado);
  }

  .pestana__texto {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .pestana__texto--corto {
    display: none;
  }

  /* En pantallas angostas: nombres cortos, sin favicon ni botones de ventana. */
  @container navegador (max-width: 30rem) {
    .web__puntos,
    .pestana__fav,
    .pestana__texto--largo {
      display: none;
    }

    .pestana__texto--corto {
      display: block;
    }

    .pestana {
      justify-content: center;
    }

    .web__tira {
      padding-inline: var(--s-2);
    }

    .web__pestanas {
      max-width: none;
    }
  }

  .pestana__pista {
    position: absolute;
    right: 0.625rem;
    bottom: 0.3125rem;
    left: 0.625rem;
    height: 2px;
    overflow: hidden;
    border-radius: 1px;
  }

  .pestana__barra {
    display: block;
    height: 100%;
    background: var(--accent-ink);
    transform: scaleX(0);
    transform-origin: left center;
  }

  .web:not([data-auto]) .pestana[aria-selected='true'] .pestana__barra {
    transform: none;
  }

  .web__barra {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    padding: var(--s-2) var(--s-3);
    border-bottom: 1px solid var(--line);
  }

  .web__url {
    flex: 1;
    display: flex;
    align-items: center;
    gap: 0.375rem;
    min-width: 0;
    padding: 0.3125rem 0.75rem;
    border-radius: var(--radius-pill);
    background: var(--bg);
    color: var(--ink-2);
    font-size: 0.8125rem;
  }

  .web__url span {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .web__sello {
    flex: none;
    padding: 0.125rem 0.625rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-pill);
    color: var(--ink-2);
    font-size: 0.75rem;
    font-weight: 600;
  }

  /* Sin JS: los tres sistemas en fila, cada uno con su nombre. Con JS: apilados y uno visible. */
  .web__paneles {
    position: relative;
    container: app / inline-size;
  }

  .panel__nombre {
    padding: var(--s-3) var(--s-4) var(--s-2);
    border-top: 1px solid var(--line);
    font-weight: 650;
  }

  .panel:first-child .panel__nombre {
    border-top: 0;
  }

  .web[data-js] .web__paneles {
    display: grid;
  }

  .web[data-js] .panel {
    grid-area: 1 / 1;
    display: grid;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 180ms ease,
      visibility 0s linear 180ms;
  }

  .web[data-js] .panel.activo {
    opacity: 1;
    visibility: visible;
    transition:
      opacity 240ms ease 60ms,
      visibility 0s;
  }

  .web[data-js] .panel__nombre {
    display: none;
  }

  /* ── La app de ejemplo ─────────────────────────────────────────────── */

  .app {
    display: grid;
    grid-template-columns: 8.5rem minmax(0, 1fr);
    min-height: 100%;
    background: var(--app-bg);
    color: var(--app-ink);
    font-size: 0.75rem;
    line-height: 1.35;
  }

  .app__lado {
    display: grid;
    align-content: start;
    gap: var(--s-4);
    padding: var(--s-4) var(--s-2);
    background: var(--app-lado);
    color: var(--app-lado-ink);
  }

  .app__marca {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    padding: 0 var(--s-1);
    color: #fff;
    font-weight: 700;
  }

  .app__logo {
    display: grid;
    place-items: center;
    flex: none;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 6px;
    background: var(--app-acento-hondo);
    color: #fff;
    font-size: 0.625rem;
    font-weight: 800;
    letter-spacing: 0.02em;
  }

  .app__marca-n {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .app__nav {
    display: grid;
    gap: 2px;
  }

  .app__item {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    padding: 0.375rem var(--s-2);
    border-radius: 6px;
  }

  .app__item :global(.glifo) {
    font-size: 0.9375rem;
  }

  .app__item.activo {
    background: rgb(255 255 255 / 0.1);
    color: #fff;
    font-weight: 650;
  }

  .app__main {
    display: grid;
    align-content: start;
    gap: var(--s-3);
    min-width: 0;
    padding: var(--s-4);
  }

  .app__cabeza {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-3);
  }

  .app__titulos {
    display: grid;
    min-width: 0;
  }

  .app__h {
    font-size: 0.9375rem;
    font-weight: 750;
    line-height: 1.25;
  }

  .app__sub {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    color: var(--app-ink-2);
  }

  .app__buscar {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.375rem 0.625rem;
    border: 1px solid var(--app-line);
    border-radius: 6px;
    background: var(--app-panel);
    color: var(--app-ink-2);
    white-space: nowrap;
  }

  .app__avatar {
    display: grid;
    place-items: center;
    flex: none;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: var(--app-azul);
    color: #fff;
    font-size: 0.6875rem;
    font-weight: 750;
  }

  .num {
    font-variant-numeric: tabular-nums;
    text-align: right;
  }

  .chip {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.125rem 0.4375rem;
    border-radius: var(--radius-pill);
    font-size: 0.6875rem;
    font-weight: 650;
    white-space: nowrap;
  }

  .chip :global(.glifo) {
    font-size: 0.6875rem;
  }

  .chip--ok {
    background: var(--app-ok-bg);
    color: var(--app-ok-ink);
  }

  .chip--quedan {
    background: var(--app-alerta-ink);
    color: #fff;
  }

  .chip--surtir {
    background: var(--app-alerta-bg);
    color: var(--app-alerta-ink);
  }

  .chip--neutro {
    background: var(--app-bg);
    border: 1px solid var(--app-line);
    color: var(--app-ink-2);
  }

  /* Inventario */
  .kpis {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--s-2);
  }

  .kpi {
    display: grid;
    gap: 0.125rem;
    padding: var(--s-2) var(--s-3);
    border: 1px solid var(--app-line);
    border-radius: 8px;
    background: var(--app-panel);
  }

  .kpi__l {
    color: var(--app-ink-2);
  }

  .kpi__v {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 1.125rem;
    font-weight: 750;
    font-stretch: 92%;
    line-height: 1.15;
  }

  .kpi--alerta .kpi__v :global(.glifo) {
