---
/**
 * Visor de la demo en vivo. Sin JS se ve el póster con marca de agua, las
 * combinaciones de color y el enlace a la demo. Con JS (src/scripts/visor.ts):
 * selector de dispositivo, iframe con sandbox y "Pruébala con otros colores"
 * por postMessage. El protocolo está en README.md.
 */
import type { Landing } from '../lib/landings';
import CapturaMarcada from './CapturaMarcada.astro';
import FichaColor from './FichaColor.astro';
import Icono from './Icono.astro';

interface Props {
  landing: Landing;
}

const { landing } = Astro.props;
const dispositivos = [
  { id: 'celular', nombre: 'Celular', icono: 'device-mobile' },
  { id: 'tablet', nombre: 'Tablet', icono: 'device-tablet' },
  { id: 'escritorio', nombre: 'Escritorio', icono: 'desktop' },
] as const;
const giro = landing.giro.toLowerCase();
---

<div class="visor" data-visor data-demo={landing.demo} data-codigo={landing.codigo}>
  <div class="visor__controles">
    <div
      class="segmentado"
      role="group"
      aria-label="Tamaño de pantalla de la demo"
      data-visor-dispositivos
      hidden
    >
      {
        dispositivos.map((d) => (
          <button type="button" class="segmentado__boton" data-dispositivo={d.id} aria-pressed="false">
            <Icono nombre={d.icono} />
            <span>{d.nombre}</span>
          </button>
        ))
      }
    </div>
    <a class="visor__abrir" href={landing.demo} target="_blank" rel="noopener" data-visor-abrir>
      Abrir la demo en otra pestaña <Icono nombre="arrow-square-out" />
    </a>
  </div>

  <div class="visor__escenario">
    <div class="visor__dispositivo" data-visor-marco data-dispositivo="auto">
      <div class="visor__pantalla">
        <CapturaMarcada
          clase="visor__poster visor__poster--movil"
          imagen={landing.imagenes.movil}
          alt={`Captura en celular de la landing ${landing.codigo} para ${giro}`}
          codigo={landing.codigo}
          anchos={[320, 390, 640, 780]}
          sizes="390px"
          prioridad
        />
        <CapturaMarcada
          clase="visor__poster visor__poster--escritorio"
          imagen={landing.imagenes.escritorio}
          alt={`Captura en escritorio de la landing ${landing.codigo} para ${giro}`}
          codigo={landing.codigo}
          anchos={[640, 960, 1280, 1600]}
          sizes="(min-width: 75rem) 800px, 100vw"
        />
        <p class="visor__estado" data-visor-estado role="status"></p>
      </div>
    </div>
  </div>

  <div class="visor__temas">
    <h2 class="titulo" id="temas-titulo">Pruébala con otros colores</h2>
    <p class="visor__nota">
      Cada combinación cambia los colores de la demo en vivo. Al comprarla eliges una o nos pides los
      colores de tu marca.
    </p>
    <div class="fichas-tema" role="group" aria-labelledby="temas-titulo">
      {
        landing.temas.map((tema) => (
          <button
            type="button"
            class="ficha-tema"
            data-tema={tema.id}
            data-nombre={tema.nombre}
            aria-pressed={tema.id === landing.tema_por_defecto ? 'true' : 'false'}
          >
            <FichaColor tema={tema} />
            <span>{tema.nombre}</span>
          </button>
        ))
      }
    </div>
    <p class="visually-hidden" data-visor-aviso role="status"></p>
  </div>
</div>

<script>
  import { iniciarVisores } from '../scripts/visor';
  iniciarVisores();
</script>

<style>
  .visor {
    display: grid;
    gap: var(--s-4);
  }

  .visor__controles {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-2) var(--s-4);
    min-height: 48px;
  }

  .segmentado {
    display: inline-flex;
    padding: 3px;
    border: 1px solid var(--line);
    border-radius: calc(var(--radius) + 3px);
    background: var(--surface);
  }

  .segmentado[hidden] {
    display: none;
  }

  .segmentado__boton {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    min-height: 40px;
    padding: 0 var(--s-3);
    border: 0;
    border-radius: var(--radius);
    background: transparent;
    color: var(--ink-2);
    font-size: 0.9375rem;
    font-weight: 600;
    cursor: pointer;
    transition:
      background-color var(--dur-fast) ease,
      color var(--dur-fast) ease,
      transform var(--dur-press) var(--ease-out);
  }

  .segmentado__boton:active {
    transform: scale(0.97);
  }

  .segmentado__boton[aria-pressed='true'] {
    background: var(--ink);
    color: var(--bg);
  }

  @media (hover: hover) and (pointer: fine) {
    .segmentado__boton[aria-pressed='false']:hover {
      background: var(--bg);
      color: var(--ink);
    }
  }

  @media (max-width: 29.99rem) {
    .segmentado__boton span {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    .segmentado__boton {
      min-width: 44px;
      min-height: 44px;
      justify-content: center;
    }
  }

  .visor__abrir {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    min-height: 44px;
    font-size: 0.9375rem;
    font-weight: 600;
  }

  .visor__abrir[hidden] {
    display: none;
  }

  /* Escenario: el tamaño del marco lo decide CSS; JS solo calcula la escala del iframe. */
  .visor__escenario {
    container-type: inline-size;
    display: grid;
    place-items: center;
    padding: clamp(0.75rem, 0.3rem + 2vw, 2rem);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--bg);
  }

  .visor__dispositivo {
    --w: 390;
    --h: 844;
    --alto-max: 74svh;
    --bisel: 8px;
    padding: var(--bisel);
    border-radius: var(--radius-device);
    background: var(--ink);
    box-shadow: var(--e-device);
  }

  .visor__dispositivo[data-dispositivo='tablet'] {
    --w: 768;
    --h: 1024;
    --bisel: 10px;
  }

  .visor__dispositivo[data-dispositivo='escritorio'] {
    --w: 1280;
    --h: 800;
    --bisel: 0px;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--surface);
  }

  @media (min-width: 64rem) {
    .visor__dispositivo[data-dispositivo='auto'] {
      --w: 1280;
      --h: 800;
      --bisel: 0px;
      border: 1px solid var(--line);
      border-radius: var(--radius-md);
      background: var(--surface);
    }
  }

  .visor__pantalla {
    position: relative;
    overflow: hidden;
    width: min(
      calc(var(--w) * 1px),
      calc(var(--alto-max) * var(--w) / var(--h)),
      calc(100cqi - 2 * var(--bisel))
    );
    aspect-ratio: var(--w) / var(--h);
    border-radius: calc(var(--radius-device) - var(--bisel));
    background: var(--surface);
  }

  [data-dispositivo='escritorio'] > .visor__pantalla {
    border-radius: calc(var(--radius-md) - 1px);
  }

  @media (min-width: 64rem) {
    [data-dispositivo='auto'] > .visor__pantalla {
      border-radius: calc(var(--radius-md) - 1px);
    }
  }

  .visor__pantalla :global(.visor__poster) {
    position: absolute;
    inset: 0;
  }

  .visor__pantalla :global(.visor__poster--escritorio) {
    display: none;
  }

  [data-dispositivo='tablet'] :global(.visor__poster--movil),
  [data-dispositivo='escritorio'] :global(.visor__poster--movil) {
    display: none;
  }

  [data-dispositivo='tablet'] :global(.visor__poster--escritorio),
  [data-dispositivo='escritorio'] :global(.visor__poster--escritorio) {
    display: block;
  }

  @media (min-width: 64rem) {
    [data-dispositivo='auto'] :global(.visor__poster--movil) {
      display: none;
    }

    [data-dispositivo='auto'] :global(.visor__poster--escritorio) {
      display: block;
    }
  }

  .visor__pantalla :global(.visor__iframe) {
    position: absolute;
    top: 0;
    left: 0;
    width: calc(var(--w) * 1px);
    height: calc(var(--h) * 1px);
    border: 0;
    background: var(--surface);
    opacity: 0;
    transform: scale(var(--escala, 1));
    transform-origin: 0 0;
    transition: opacity var(--dur-base) var(--ease-out);
  }

  [data-estado='cargada'] :global(.visor__iframe) {
    opacity: 1;
  }

  .visor__estado {
    position: absolute;
    left: 50%;
    bottom: var(--s-6);
    z-index: 1;
    width: max-content;
    max-width: calc(100% - 2rem);
    padding: var(--s-2) var(--s-3);
    border-radius: var(--radius);
    background: var(--ink);
    color: var(--bg);
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.4;
    text-align: center;
    transform: translateX(-50%);
  }

  .visor__estado:empty {
    display: none;
  }

  /* Pruébala con otros colores */
  .visor__temas {
    display: grid;
    gap: var(--s-3);
    margin-top: var(--s-4);
  }

  .visor__nota {
    color: var(--ink-2);
    max-width: 60ch;
  }

  .fichas-tema {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(6.5rem, 1fr));
    gap: var(--s-3);
    max-width: 36rem;
    margin-top: var(--s-2);
  }

  .ficha-tema {
    display: grid;
    gap: var(--s-2);
    padding: var(--s-2);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--ink);
    font-size: 0.9375rem;
    font-weight: 600;
    text-align: left;
    cursor: pointer;
    transition:
      border-color var(--dur-fast) ease,
      box-shadow var(--dur-fast) ease,
      transform var(--dur-press) var(--ease-out);
  }

  .ficha-tema:active {
    transform: scale(0.97);
  }

  .ficha-tema[aria-pressed='true'] {
    border-color: var(--ink);
    box-shadow: inset 0 0 0 1px var(--ink);
  }

  .ficha-tema[aria-disabled='true'] {
    cursor: not-allowed;
    color: var(--ink-3);
  }

  @media (hover: hover) and (pointer: fine) {
    .ficha-tema:not([aria-pressed='true']):hover {
      border-color: var(--line-strong);
    }
  }
</style>
