---
/**
 * Tira del muestrario: una landing de la vitrina. Toda la tira es un solo
 * enlace (patrón de enlace estirado desde el título), sin botones anidados.
 * En celular es una fila; desde 768 px, una columna.
 */
import type { Landing } from '../lib/landings';
import { fechaCorta, pesosMXN } from '../lib/formato';
import CapturaMarcada from './CapturaMarcada.astro';
import FichaColor from './FichaColor.astro';
import Icono from './Icono.astro';

interface Props {
  landing: Landing;
  nivel?: 2 | 3;
}

const { landing, nivel = 3 } = Astro.props;
const Titulo = nivel === 2 ? 'h2' : 'h3';
const href = `/landings/${landing.slug}/`;
---

<article class="tira">
  <CapturaMarcada
    clase="tira__captura"
    imagen={landing.imagenes.movil}
    alt={`Captura en celular de la landing ${landing.codigo} para ${landing.giro.toLowerCase()}`}
    codigo={landing.codigo}
    anchos={[120, 240, 300, 600]}
    sizes="(min-width: 48rem) 300px, 120px"
  />
  <div class="tira__cuerpo">
    <Titulo class="tira__titulo">
      <a class="tira__enlace" href={href}>
        {landing.giro}<span class="visually-hidden">: ver demo y precio de {landing.codigo}</span>
      </a>
    </Titulo>
    <p class="tira__meta">
      <span class="codigo">{landing.codigo}</span>
      <span>Modelo {landing.nombre}</span>
      <time datetime={landing.fecha}>{fechaCorta(landing.fecha)}</time>
    </p>
    <ul class="tira__temas" aria-label="Combinaciones de color">
      {
        landing.temas.slice(0, 4).map((tema) => (
          <li>
            <FichaColor tema={tema} />
            <span>{tema.nombre}</span>
          </li>
        ))
      }
    </ul>
    <p class="tira__precio">
      desde <strong class="cifra">{pesosMXN(landing.precio_desde)}</strong> MXN
    </p>
    <span class="tira__accion" aria-hidden="true">Ver demo <Icono nombre="arrow-right" /></span>
  </div>
</article>

<style>
  .tira {
    position: relative;
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr);
    gap: var(--s-4);
    padding: var(--s-3);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--surface);
    transition:
      transform var(--dur-state) var(--ease-out),
      border-color var(--dur-fast) ease;
  }

  /* La sombra vive en un pseudo-elemento y solo se anima su opacidad. */
  .tira::after {
    content: '';
    position: absolute;
    inset: -1px;
    border-radius: inherit;
    box-shadow: var(--e1);
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--dur-state) var(--ease-out);
  }

  .tira :global(.tira__captura) {
    aspect-ratio: 9 / 16;
    border-radius: var(--radius);
  }

  .tira__cuerpo {
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
    min-width: 0;
    padding-block: var(--s-1);
  }

  .tira__titulo {
    font-size: var(--fs-title);
    font-weight: 700;
    font-stretch: 108%;
    line-height: 1.15;
    letter-spacing: -0.015em;
  }

  .tira__enlace {
    color: var(--ink);
    text-decoration: none;
  }

  .tira__enlace::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: var(--radius-md);
  }

  .tira__enlace:focus-visible {
    outline: none;
  }

  .tira:has(.tira__enlace:focus-visible) {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }

  .tira__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--s-3);
    color: var(--ink-3);
    font-size: var(--fs-label);
  }

  .tira__meta .codigo {
    color: var(--ink);
    font-size: inherit;
  }

  .tira__temas {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--s-2);
    margin-top: var(--s-1);
    padding: 0;
    list-style: none;
  }

  .tira__temas li {
    display: grid;
    gap: 2px;
    min-width: 0;
    color: var(--ink-3);
    font-size: 0.75rem;
    line-height: 1.3;
  }

  .tira__temas li span {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .tira__precio {
    margin-top: auto;
    padding-top: var(--s-2);
    color: var(--ink-2);
    font-size: 0.9375rem;
  }

  .tira__precio strong {
    color: var(--ink);
    font-size: 1.375rem;
    font-weight: 700;
  }

  .tira__accion {
    display: inline-flex;
    align-items: center;
    gap: var(--s-1);
    color: var(--accent-ink);
    font-weight: 650;
  }

  .tira__accion :global(.icono) {
    transition: transform var(--dur-state) var(--ease-out);
  }

  .tira:active {
    transform: scale(0.98);
  }

  @media (hover: hover) and (pointer: fine) {
    .tira:hover {
      transform: translateY(-4px);
      border-color: var(--line-strong);
    }

    .tira:hover::after {
      opacity: 1;
    }

    .tira:hover .tira__accion :global(.icono) {
      transform: translateX(3px);
    }
  }

  @media (min-width: 48rem) {
    .tira {
      grid-template-columns: minmax(0, 1fr);
      align-content: start;
    }

    .tira__cuerpo {
      padding: var(--s-2) var(--s-1) var(--s-1);
    }
  }
</style>
