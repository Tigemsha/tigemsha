---
/** La landing más reciente, en grande: captura en celular y su ficha de venta. */
import type { Landing } from '../lib/landings';
import { fechaLarga, pesosMXN } from '../lib/formato';
import { enlaceWhatsApp, mensajes } from '../lib/whatsapp';
import CapturaMarcada from './CapturaMarcada.astro';
import FichaColor from './FichaColor.astro';
import Icono from './Icono.astro';

interface Props {
  landing: Landing;
}

const { landing } = Astro.props;
const href = `/landings/${landing.slug}`;
---

<article class="destacada" aria-labelledby={`destacada-${landing.slug}`}>
  <div class="destacada__telefono">
    <CapturaMarcada
      clase="destacada__captura"
      imagen={landing.imagenes.movil}
      alt={`Captura en celular de la landing ${landing.codigo} para ${landing.giro.toLowerCase()}`}
      codigo={landing.codigo}
      anchos={[260, 320, 520, 640]}
      sizes="(min-width: 64rem) 320px, 260px"
    />
  </div>

  <div class="destacada__ficha">
    <h3 id={`destacada-${landing.slug}`} class="destacada__titulo">
      Landing para {landing.giro.toLowerCase()}
    </h3>
    <p class="destacada__meta">
      <span class="codigo">{landing.codigo}</span>
      <span aria-hidden="true">·</span>
      <span>Modelo {landing.nombre}</span>
      <span aria-hidden="true">·</span>
      <span>Publicada el <time datetime={landing.fecha}>{fechaLarga(landing.fecha)}</time></span>
    </p>
    <p class="destacada__resumen">{landing.resumen}</p>

    <ul class="destacada__incluye">
      {
        landing.incluye.slice(0, 4).map((item) => (
          <li>
            <Icono nombre="check" />
            <span>{item}</span>
          </li>
        ))
      }
    </ul>

    <div class="destacada__temas">
      <p class="etiqueta">Viene en {landing.temas.length} combinaciones de color</p>
      <ul aria-label="Combinaciones de color">
        {
          landing.temas.map((tema) => (
            <li>
              <FichaColor tema={tema} />
              <span>{tema.nombre}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="destacada__compra">
      <p class="destacada__precio">
        <span>desde</span>
        <strong class="cifra">{pesosMXN(landing.precio_desde)}</strong>
        <span>MXN</span>
      </p>
      <p class="destacada__mantenimiento">
        Mantenimiento: <span class="cifra">{pesosMXN(landing.mantenimiento_mes)}</span> MXN al mes
      </p>
    </div>

    <div class="acciones">
      <a class="btn btn--primario" href={href}>Ver demo y detalles <Icono nombre="arrow-right" /></a>
      <a class="btn btn--secundario" href={enlaceWhatsApp(mensajes.laQuiero(landing))} rel="noopener">
        <Icono nombre="whatsapp" /> La quiero
      </a>
    </div>
  </div>
</article>

<style>
  .destacada {
    display: grid;
    gap: var(--s-8);
    padding: clamp(1.25rem, 0.6rem + 2.8vw, 3rem);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--surface);
  }

  .destacada__telefono {
    justify-self: center;
    width: min(100%, 16.25rem);
    padding: 8px;
    border-radius: var(--radius-device);
    background: var(--ink);
    box-shadow: var(--e-device);
  }

  .destacada__telefono :global(.destacada__captura) {
    aspect-ratio: 9 / 19.5;
    border-radius: calc(var(--radius-device) - 8px);
  }

  .destacada__ficha {
    display: flex;
    flex-direction: column;
    gap: var(--s-5);
    min-width: 0;
  }

  .destacada__titulo {
    font-size: var(--fs-headline);
    font-weight: 750;
    font-stretch: 108%;
    line-height: 1.08;
    letter-spacing: -0.02em;
  }

  .destacada__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--s-2);
    margin-top: calc(var(--s-3) * -1);
    color: var(--ink-3);
    font-size: var(--fs-label);
  }

  .destacada__meta .codigo {
    color: var(--ink);
    font-size: inherit;
  }

  .destacada__resumen {
    color: var(--ink-2);
    font-size: var(--fs-lead);
    line-height: 1.5;
    max-width: 48ch;
  }

  .destacada__incluye {
    display: grid;
    gap: var(--s-2);
    padding: 0;
    list-style: none;
  }

  .destacada__incluye li {
    display: flex;
    gap: var(--s-3);
    align-items: flex-start;
    max-width: 56ch;
  }

  .destacada__incluye :global(.icono) {
    margin-top: 0.2em;
    color: var(--accent-ink);
  }

  .destacada__temas {
    display: grid;
    gap: var(--s-2);
  }

  .destacada__temas ul {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 4.5rem));
    gap: var(--s-3);
    padding: 0;
    list-style: none;
  }

  .destacada__temas li {
    display: grid;
    gap: var(--s-1);
    font-size: var(--fs-label);
    color: var(--ink-2);
  }

  .destacada__compra {
    display: grid;
    gap: var(--s-1);
    padding-top: var(--s-5);
    border-top: 1px solid var(--line);
  }

  .destacada__precio {
    display: flex;
    align-items: baseline;
    gap: var(--s-2);
    color: var(--ink-2);
  }

  .destacada__precio strong {
    color: var(--ink);
    font-size: clamp(2rem, 1.6rem + 1.6vw, 2.75rem);
    font-weight: 750;
    line-height: 1;
  }

  .destacada__mantenimiento {
    color: var(--ink-3);
    font-size: 0.9375rem;
  }

  @media (min-width: 64rem) {
    .destacada {
      grid-template-columns: auto 1fr;
      gap: clamp(2.5rem, 1rem + 4vw, 5rem);
      align-items: center;
    }

    .destacada__telefono {
      width: 20rem;
    }
  }
</style>
