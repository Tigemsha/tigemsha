---
/** Sello "Muestra · TGM-001" sobre una captura o sobre la demo en vivo. No recibe clics. */
import { type Idioma, t } from '../i18n';

interface Props {
  idioma: Idioma;
  codigo: string;
  clase?: string;
}

const { idioma, codigo, clase = '' } = Astro.props;
---

<span class:list={['sello', 'codigo', clase]} aria-hidden="true" data-sello
  >{t(idioma).captura.sello} · <span data-sello-codigo>{codigo}</span></span
>

<style>
  .sello {
    position: absolute;
    left: var(--s-2);
    bottom: var(--s-2);
    padding: 2px var(--s-2);
    border-radius: var(--radius-xs);
    background: var(--sello-bg);
    color: var(--sello-ink);
    font-size: 0.75rem;
    line-height: 1.5;
    letter-spacing: 0.04em;
    pointer-events: none;
    white-space: nowrap;
  }
</style>
