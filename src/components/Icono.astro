---
/**
 * Íconos de Phosphor (peso regular) como SVG en línea. Siempre decorativos:
 * el texto de al lado (o un texto oculto) da el nombre accesible.
 */
import arrowRight from '@phosphor-icons/core/regular/arrow-right.svg?raw';
import arrowSquareOut from '@phosphor-icons/core/regular/arrow-square-out.svg?raw';
import arrowsClockwise from '@phosphor-icons/core/regular/arrows-clockwise.svg?raw';
import bell from '@phosphor-icons/core/regular/bell.svg?raw';
import calendarCheck from '@phosphor-icons/core/regular/calendar-check.svg?raw';
import caretDown from '@phosphor-icons/core/regular/caret-down.svg?raw';
import caretLeft from '@phosphor-icons/core/regular/caret-left.svg?raw';
import caretRight from '@phosphor-icons/core/regular/caret-right.svg?raw';
import chartBar from '@phosphor-icons/core/regular/chart-bar.svg?raw';
import check from '@phosphor-icons/core/regular/check.svg?raw';
import checkCircle from '@phosphor-icons/core/regular/check-circle.svg?raw';
import desktop from '@phosphor-icons/core/regular/desktop.svg?raw';
import deviceMobile from '@phosphor-icons/core/regular/device-mobile.svg?raw';
import deviceTablet from '@phosphor-icons/core/regular/device-tablet.svg?raw';
import envelope from '@phosphor-icons/core/regular/envelope-simple.svg?raw';
import globe from '@phosphor-icons/core/regular/globe-simple.svg?raw';
import instagram from '@phosphor-icons/core/regular/instagram-logo.svg?raw';
import magnifyingGlass from '@phosphor-icons/core/regular/magnifying-glass.svg?raw';
import packageIcon from '@phosphor-icons/core/regular/package.svg?raw';
import pause from '@phosphor-icons/core/regular/pause.svg?raw';
import play from '@phosphor-icons/core/regular/play.svg?raw';
import receipt from '@phosphor-icons/core/regular/receipt.svg?raw';
import tiktok from '@phosphor-icons/core/regular/tiktok-logo.svg?raw';
import whatsapp from '@phosphor-icons/core/regular/whatsapp-logo.svg?raw';

const iconos = {
  'arrow-right': arrowRight,
  'arrow-square-out': arrowSquareOut,
  'arrows-clockwise': arrowsClockwise,
  bell,
  'calendar-check': calendarCheck,
  'caret-down': caretDown,
  'caret-left': caretLeft,
  'caret-right': caretRight,
  'chart-bar': chartBar,
  check,
  'check-circle': checkCircle,
  desktop,
  'device-mobile': deviceMobile,
  'device-tablet': deviceTablet,
  envelope,
  globe,
  instagram,
  'magnifying-glass': magnifyingGlass,
  package: packageIcon,
  pause,
  play,
  receipt,
  tiktok,
  whatsapp,
} as const;

export type NombreIcono = keyof typeof iconos;

interface Props {
  nombre: NombreIcono;
  clase?: string;
}

const { nombre, clase = '' } = Astro.props;
const svg = iconos[nombre].replace(
  '<svg ',
  `<svg class="icono ${clase}" aria-hidden="true" focusable="false" `,
);
---

<Fragment set:html={svg} />
